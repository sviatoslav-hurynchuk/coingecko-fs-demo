# CoinGecko API Configuration
# Free Demo plan uses base URL: https://api.coingecko.com/api/v3
# Paid Pro plan uses base URL: https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_PLAN=demo

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CACHE_TTL_SECONDS=60
